# ---- Build-time (mark as "Build time" in Coolify; inlined into the bundle) ----
NEXT_PUBLIC_SITE_URL=https://revixplus.com
NEXT_PUBLIC_CAL_LINK=https://cal.com/farrukhbilal

# ---- Runtime ----------------------------------------------------------------
# AI concierge (/api/chat). Without a key the endpoint returns 503 and the UI degrades gracefully.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Lead delivery (/api/lead and the concierge's send_brief tool)
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@revixplus.com
LEAD_FROM_EMAIL="RevixPlus <leads@revixplus.com>"
N8N_WEBHOOK_URL=

# Optional
APP_VERSION=
